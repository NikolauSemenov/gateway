# Logging
LOG_LEVEL=INFO

# HTTP server
ADDRESS=0.0.0.0:8000
TIMEOUT=5s
IDLE_TIMEOUT=60s
API_PREFIX=gateway
APP_VERSION=v1
LIMIT_READ=65536

# Auth service
AUTH_BASE_URL=http://localhost:8084/auth/api
AUTH_V1_REGISTER=/v1/register
AUTH_V1_LOGIN=/v1/login
AUTH_V1_VERIFY=/v1/verify
AUTH_V1_LOGOUT=/v1/logout
AUTH_V1_SEND_EMAIL_CODE=/v1/send-email-code
AUTH_V1_VERIFY_EMAIL=/v1/verify-email-code

# Note-flow service
NOTE_FLOW_BASE_URL=http://localhost:8083/note-flow/api
NOTE_FLOW_V1_NOTES=/v1/notes
NOTE_FLOW_V1_NOTE=/v1/note
NOTE_FLOW_V1_NOTE_ACTIVE=/v1/note/active
NOTE_FLOW_V1_NOTE_LIKE=/v1/note/like
NOTE_FLOW_V1_NOTE_COMMENT=/v1/note/comment
