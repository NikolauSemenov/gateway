                    },
                    "400": {
                        "description": "Неверный ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/gateway/api/v1/note-flow/notes": {
            "get": {
                "description": "Проксирует запрос по пути /notes",
                "tags": [
                    "note-flow"
